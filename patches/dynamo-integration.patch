-            }
-        }
-        queue.update().await;
-
-        let mut ok_count = 0;
-        for mut rx in receivers {
-            if let Ok(result) = rx.try_recv() {
-                result.expect("scheduling returned error");
-                ok_count += 1;
-            }
-        }
-        assert_eq!(ok_count, num_requests, "not all requests were scheduled");
