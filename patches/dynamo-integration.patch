+#[pyclass]
+pub(crate) struct AlignedRouter;
+
+#[pymethods]
+impl AlignedRouter {
+    #[new]
+    fn new() -> Self { Self }
+
+    #[pyo3(signature = (request_id, input_tokens, allowed_workers, pinned_worker=None))]
+    fn reserve<'p>(&self, py: Python<'p>, request_id: String, input_tokens: usize,
+                   allowed_workers: Vec<u64>, pinned_worker: Option<u64>)
+                   -> PyResult<Bound<'p, PyAny>> {
+        let router = llm_rs::aligned::router().map_err(to_pyerr)?;
+        pyo3_async_runtimes::tokio::future_into_py(py, async move {
+            let worker = router.aligned_reserve(request_id, input_tokens,
+                allowed_workers.into_iter().collect(), pinned_worker).await.map_err(to_pyerr)?;
+            Ok((worker.worker_id, worker.dp_rank))
+        })
+    }
+
+    fn free<'p>(&self, py: Python<'p>, request_id: String) -> PyResult<Bound<'p, PyAny>> {
+        let router = llm_rs::aligned::router().map_err(to_pyerr)?;
+        pyo3_async_runtimes::tokio::future_into_py(py, async move {
+            router.free(&request_id).await.map_err(to_pyerr)
+        })
+    }
+
+    fn loads(&self) -> PyResult<Vec<(u64, u32, usize, f64, usize)>> {
+        let router = llm_rs::aligned::router().map_err(to_pyerr)?;
+        Ok(router.aligned_loads().into_iter().map(|load|
+            (load.worker_id, load.dp_rank, load.potential_prefill_tokens,
+             load.potential_decode_blocks as f64, load.active_requests)).collect())
+    }
+}
